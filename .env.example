NR3_ENV=development
NR3_ADMIN_PASSWORD=change-me
NR3_SESSION_SECRET=change-me-to-a-long-random-value
NR3_DB_PATH=data/nr3.db
NR3_TENANT_REGISTRY_PATH=data/tenant_registry.json
NR3_ALLOWED_IPS=127.0.0.1/32
NR3_BASE_URL=http://127.0.0.1:8010
NR3_EMAIL_FROM=onboarding@unboks.org
NR3_SMTP_HOST=
NR3_SMTP_PORT=587
NR3_SMTP_USERNAME=
NR3_SMTP_PASSWORD=
NR3_SMTP_USE_TLS=true
# Legacy shared bridge fallback only. Leave empty in production; the worker
# writes one rotated token per tenant into the mounted directory below.
NR3_INTERNAL_API_TOKEN=
NR3_TENANT_BRIDGE_TOKEN_DIR=/app/tenant_root/_shared/nr3_bridge_tokens
NR3_ALLOW_LEGACY_SHARED_BRIDGE_TOKEN=false
# Tenant-scoped Nr3/Nr2 knowledge bridge: reads plus guarded operator
# mutations. Use the public API template in production unless the ICP
# container shares Docker DNS with all tenant containers.
NR3_TENANT_API_BASE_TEMPLATE=https://api.unboks.org/api/{tenant}/dashboard/api
NR3_NR2_KNOWLEDGE_CACHE_PATH=data/nr2_knowledge_cache.json
NR3_NR2_KNOWLEDGE_CACHE_TTL_SECONDS=900
# Tenant-scoped operator state. Keep these files on the same durable data
# volume as the database and lifecycle ledgers; mutation paths fail closed if
# an existing shared store is unreadable or malformed.
NR3_CHANNEL_STATE_PATH=data/channel_state.json
NR3_ICP_STATE_PATH=data/icp_overrides.json
NR3_TENANT_NOTES_PATH=data/tenant_notes.json
NR3_PROMPT_CONFLICT_RESOLUTIONS_PATH=data/prompt_conflict_resolutions.json

# Public signup safety. Public signup stores a request first; it must not
# provision privileged tenant resources until the email is verified and this
# explicit server-side flag is enabled.
NR3_PUBLIC_SIGNUP_REQUESTS_PATH=data/public_signup_requests.json
NR3_PUBLIC_SIGNUP_AUTO_PROVISION_AFTER_VERIFY=false
NR3_PUBLIC_SIGNUP_RATE_LIMIT_PER_IP_PER_HOUR=5
NR3_PUBLIC_SIGNUP_RATE_LIMIT_PER_EMAIL_PER_DAY=3
NR3_PUBLIC_SIGNUP_VERIFICATION_TTL_HOURS=48
NR3_PUBLIC_SIGNUP_ADMIN_EMAIL=

# Zernio WhatsApp connection flow. ZERNIO_API_KEY must only be set in
# private server env, never in templates or browser JavaScript.
ZERNIO_API_KEY=
ZERNIO_API_BASE_URL=https://zernio.com/api/v1
ZERNIO_WEBHOOK_SECRET=
LATE_API_KEY=
UNBOKS_PUBLIC_URL=https://unboks.org
UNBOKS_ADMIN_API_URL=https://icp.unboks.org/internal/api

# Automatic VPS tenant provisioning. Keep disabled locally. On the VPS,
# enable this only after the root systemd worker is installed.
NR3_AUTO_PROVISION=false
# Queue-v2 app paths. Keep all of these on the same durable ./data mount and
# use the matching host paths from host/nr3-provision-worker.service.
NR3_PROVISION_QUEUE_DIR=data/provisioning/jobs
NR3_PROVISION_RESULT_DIR=data/provisioning/results
NR3_PROVISION_RECONCILED_DIR=data/provisioning/reconciled
NR3_PROVISION_CLAIMS_PATH=data/provisioning/tenant_claims.json
NR3_TENANT_CREATE_LOCK_DIR=data/provisioning/create-locks
NR3_DELETE_OPERATIONS_DIR=data/provisioning/delete-operations
# Optional explicit override. When empty, the provider-orphan ledger lives
# under NR3_DELETE_OPERATIONS_DIR and is backed up with lifecycle state.
NR3_PROVIDER_ORPHAN_LEDGER_PATH=
NR3_PROVISION_TIMEOUT_SECONDS=45
NR3_PORT_REGISTRY_PATH=data/port_registry.json
NR3_TENANT_PORT_START=8100
NR3_TENANT_PORT_END=8999

# Backup packages and import staging are sensitive persistent data. Production
# runtime restore must use the root host worker; "direct" is for isolated,
# writable local-development fixtures only.
NR3_TENANT_EXPORTS_DIR=data/tenant_exports
NR3_TENANT_IMPORT_ROLLBACK_DIR=data/tenant_import_rollbacks
NR3_TENANT_IMPORT_PAYLOAD_DIR=data/tenant_import_payloads
NR3_TENANT_RUNTIME_RESTORE_MODE=host

# J3-BE-01: tenant discovery from client.json files at runtime.
# NR3_TENANTS_CLIENT_DIR is the in-container path the tenants loader
# will glob ({path}/*/config/client.json). Set to empty or unset to
# fall back to the hard-coded placeholder tenant list (useful for
# local dev without a tenant config tree).
NR3_TENANTS_CLIENT_DIR=/app/tenant_root
# Host-side path the docker-compose volume binds onto NR3_TENANTS_CLIENT_DIR.
# Default ./tenant_root for local dev; VPS production uses /root/clients.
NR3_TENANTS_CLIENT_HOST_DIR=./tenant_root
