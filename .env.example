NR3_ENV=development
NR3_ADMIN_PASSWORD=change-me
NR3_SESSION_SECRET=change-me-to-a-long-random-value
NR3_DB_PATH=data/nr3.db
NR3_ALLOWED_IPS=127.0.0.1/32
NR3_BASE_URL=http://127.0.0.1:8010
NR3_EMAIL_FROM=onboarding@unboks.org
NR3_SMTP_HOST=
NR3_SMTP_PORT=587
NR3_SMTP_USERNAME=
NR3_SMTP_PASSWORD=
NR3_SMTP_USE_TLS=true
NR3_INTERNAL_API_TOKEN=change-me-to-a-long-random-bridge-token
# Nr3 -> Nr2 read-only sync. Use the public API template in production unless
# the ICP container shares Docker DNS with all tenant containers.
NR3_TENANT_API_BASE_TEMPLATE=https://api.unboks.org/api/{tenant}/dashboard/api
NR3_NR2_KNOWLEDGE_CACHE_PATH=data/nr2_knowledge_cache.json
NR3_NR2_KNOWLEDGE_CACHE_TTL_SECONDS=900

# Zernio WhatsApp connection flow. ZERNIO_API_KEY must only be set in
# private server env, never in templates or browser JavaScript.
ZERNIO_API_KEY=
ZERNIO_API_BASE_URL=https://zernio.com/api/v1
ZERNIO_WEBHOOK_SECRET=
LATE_API_KEY=
UNBOKS_PUBLIC_URL=https://unboks.org
UNBOKS_ADMIN_API_URL=https://icp.unboks.org/internal/api

# Automatic VPS tenant provisioning. Keep disabled locally. On the VPS,
# enable this only after the root systemd worker is installed.
NR3_AUTO_PROVISION=false
NR3_PROVISION_QUEUE_DIR=data/provisioning/jobs
NR3_PROVISION_RESULT_DIR=data/provisioning/results
NR3_PROVISION_TIMEOUT_SECONDS=45
NR3_PORT_REGISTRY_PATH=data/port_registry.json
NR3_TENANT_PORT_START=8100
NR3_TENANT_PORT_END=8999

# J3-BE-01: tenant discovery from client.json files at runtime.
# NR3_TENANTS_CLIENT_DIR is the in-container path the tenants loader
# will glob ({path}/*/config/client.json). Set to empty or unset to
# fall back to the hard-coded placeholder tenant list (useful for
# local dev without a tenant config tree).
NR3_TENANTS_CLIENT_DIR=/app/tenant_root
# Host-side path the docker-compose volume binds onto NR3_TENANTS_CLIENT_DIR.
# Default ./tenant_root for local dev; VPS production uses /root/clients.
NR3_TENANTS_CLIENT_HOST_DIR=./tenant_root
